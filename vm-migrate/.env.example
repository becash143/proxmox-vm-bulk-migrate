# Copy this to .env and fill in real values, OR just export these
# directly in your shell before running `vmmigrate migrate` / `drift`.
# .env itself is gitignored -- never commit real credentials.

PVE_URL=https://your-pve-host:8006
PVE_TOKEN_ID=root@pam!vm-migrate
PVE_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
